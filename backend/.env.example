# Copy to .env for development, and to .env.prod for production (used by docker-compose.prod.yml).

# Must match SHARED_JWT_SECRET in the frontend's env file of the same environment
SHARED_JWT_SECRET=

# "postgres" inside Docker Compose (always the case in production), "localhost" for a backend run with uvicorn
POSTGRES_HOST=
POSTGRES_PORT=5432
# Must match the postgres env file of the same environment
POSTGRES_USER=
POSTGRES_DB=
POSTGRES_PASSWORD=

# Optional limits for 'guest' users (defaults shown); 'known' users have none
MAX_DOCS_PER_USER=2
MAX_DOC_CHARS=2000
