# Copy to .env for development, and to .env.prod for production (used by docker-compose.prod.yml).
# Use different values in each: production gets its own Google OAuth client and its own secrets.

# Signs the login cookie. Generate with: openssl rand -base64 48
INTERNAL_JWT_SECRET=

# Signs requests from the frontend server to the backend. Must match SHARED_JWT_SECRET in the
# backend's env file of the same environment. Generate with: openssl rand -base64 48
SHARED_JWT_SECRET=

# Google OAuth client ID for this environment. Development: a client whose authorized JavaScript
# origins are http://localhost:5173 and http://localhost:8000. Production: a separate client, ideally
# in a separate Google Cloud project, with only https://<your domain>. See SELF_HOSTING.md.
PUBLIC_GOOGLE_CLIENT_ID=

# Shown on /privacy and /terms as the contact for requests (optional)
PUBLIC_CONTACT_EMAIL=
